{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sherwin-franzy-reception-api",
  "main": "index.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://franzy-sherwin-wedding.vercel.app"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "franzysherwindb",
    "database_id": "18af1856-bb70-435a-af74-ef043302bd05"
  }]
  // Optional, only after enabling your own R2 storage:
  // ,"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "franzy-sherwin-reception-media" }]
}
